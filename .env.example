# AI Brain — environment template. Copy to .env and fill in. Never commit real keys.
BRAIN_DEFAULT_PROVIDER=mock
BRAIN_PREFER_LOW_COST=true
BRAIN_MAX_LATENCY_MS=8000
BRAIN_QUALITY_FLOOR=0.5
BRAIN_MAX_STEPS=12
BRAIN_MAX_TOKENS=60000
BRAIN_MAX_COST_USD=0.5
BRAIN_TASK_TIMEOUT_MS=120000
BRAIN_MODEL_TIMEOUT_MS=30000
BRAIN_MEMORY_LIMIT=8
BRAIN_SHORT_TERM_MAX=40
BRAIN_CONTEXT_MAX=16000
BRAIN_RESERVE_OUTPUT=2000

# Provider keys (leave empty to stay on offline mock):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MISTRAL_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
